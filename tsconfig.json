{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@reviewflow/shared": ["packages/shared/src"],
      "@reviewflow/shared/*": ["packages/shared/src/*"],
      "@reviewflow/database": ["packages/database/src"],
      "@reviewflow/ai-review": ["packages/ai-review/src"],
      "@reviewflow/github-client": ["packages/github-client/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
