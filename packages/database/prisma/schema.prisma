datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships           OrganizationMember[]
  sessions              Session[]
  feedbacks             FindingFeedback[]
  auditLogs             AuditLog[]
  codebaseConversations CodebaseConversation[]
  approvalRequests      ApprovalRequest[]
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  token        String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  plan                 String    @default("FREE") // FREE, PRO, TEAM, ENTERPRISE
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members              OrganizationMember[]
  installations        GitHubInstallation[]
  repositories         Repository[]
  reviewPolicies       ReviewPolicy[]
  subscriptions        Subscription[]
  usageRecords         UsageRecord[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  approvalRequests     ApprovalRequest[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model GitHubInstallation {
  id             String       @id @default(cuid())
  organizationId String
  installationId Int          @unique
  accountLogin   String
  accountType    String       @default("Organization") // User or Organization
  avatarUrl      String?
  permissions    String       @default("{}") // JSON string of granted permissions
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Repository {
  id                   String       @id @default(cuid())
  organizationId       String
  githubRepoId         BigInt       @unique
  fullName             String       @unique // e.g. "acme/api-core"
  name                 String
  owner                String
  defaultBranch        String       @default("main")
  isPrivate            Boolean      @default(true)
  isActive             Boolean      @default(true)
  autoReviewEnabled    Boolean      @default(true)
  lastReviewAt         DateTime?
  lastIndexedAt        DateTime?
  lastIndexedCommitSha String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pullRequests          PullRequest[]
  reviewPolicies        ReviewPolicy[]
  indexJobs             RepositoryIndexJob[]
  indexedFiles          IndexedFile[]
  codeChunks            CodeChunk[]
  codebaseConversations CodebaseConversation[]
  testSuggestions       TestSuggestion[]
  approvalRequests      ApprovalRequest[]
}

model ReviewPolicy {
  id                     String       @id @default(cuid())
  organizationId         String
  repositoryId           String?      // Optional: null for org-wide policy, populated for repo-specific override
  enabledCategories      String       @default("[\"SECURITY\",\"CORRECTNESS\",\"PERFORMANCE\",\"MAINTAINABILITY\",\"TESTING\",\"ARCHITECTURE\"]") // JSON array
  severityThreshold      String       @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW, INFO
  blockPrOnCritical      Boolean      @default(true)
  autoPostInlineComments Boolean      @default(true)
  autoCreateCheckRun     Boolean      @default(true)
  requireTestsForNewCode Boolean      @default(true)
  maxDiffLines           Int          @default(4000)
  customInstructions     String       @default("")
  excludedPaths          String       @default("[]") // JSON array of globs
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository             Repository?  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, repositoryId])
}

model PullRequest {
  id               String              @id @default(cuid())
  repositoryId     String
  githubPrId       BigInt              // GitHub's internal PR ID (can exceed 2^31 - 1)
  number           Int                 // PR number (e.g., #42)
  title            String
  author           String
  authorAvatarUrl  String?
  baseBranch       String
  headBranch       String
  headSha          String
  state            String              @default("OPEN") // OPEN, CLOSED, MERGED
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  repository       Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  commits          PullRequestCommit[]
  reviewJobs       ReviewJob[]
  testSuggestions  TestSuggestion[]

  @@unique([repositoryId, number])
}

model PullRequestCommit {
  id            String      @id @default(cuid())
  pullRequestId String
  commitSha     String
  author        String
  message       String
  committedAt   DateTime    @default(now())

  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, commitSha])
}

model ReviewJob {
  id                 String        @id @default(cuid())
  pullRequestId      String
  commitSha          String
  status             String        @default("QUEUED") // QUEUED, FETCHING_DIFF, ANALYZING, VALIDATING, PUBLISHING, COMPLETED, FAILED, SUPERSEDED
  idempotencyKey     String        @unique
  progressPercent    Int           @default(0)
  statusMessage      String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  durationSeconds    Float?
  tokensUsed         Int           @default(0)
  estimatedCostUsd   Float         @default(0.0)
  publishedToGitHub  Boolean       @default(false)
  githubCheckRunId   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  pullRequest        PullRequest   @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  result             ReviewResult?
}

model ReviewResult {
  id                              String     @id @default(cuid())
  reviewJobId                     String     @unique
  summary                         String
  overallRisk                     String     // CRITICAL, HIGH, MEDIUM, LOW, SAFE
  riskRationale                   String
  keyStrengths                    String     @default("[]") // JSON array
  blockers                        String     @default("[]") // JSON array
  testCoverageAssessment          String
  estimatedReviewTimeSavedMinutes Int        @default(15)
  rawLlmResponse                  String?
  createdAt                       DateTime   @default(now())

  reviewJob                       ReviewJob  @relation(fields: [reviewJobId], references: [id], onDelete: Cascade)
  findings                        Finding[]
}

model Finding {
  id               String            @id @default(cuid())
  reviewResultId   String
  category         String            // SECURITY, CORRECTNESS, PERFORMANCE, etc.
  severity         String            // CRITICAL, HIGH, MEDIUM, LOW, INFO
  confidence       Int               @default(85)
  filePath         String
  startLine        Int
  endLine          Int
  title            String
  explanation      String
  evidence         String
  remediation      String
  suggestedPatch   String?
  ruleId           String?
  source           String            @default("AI_ANALYSIS") // DETERMINISTIC_STATIC, AI_ANALYSIS, SECURITY_SCAN
  githubCommentId  String?
  dismissed        Boolean           @default(false)
  dismissReason    String?
  createdAt        DateTime          @default(now())

  reviewResult     ReviewResult      @relation(fields: [reviewResultId], references: [id], onDelete: Cascade)
  feedbacks        FindingFeedback[]
}

model FindingFeedback {
  id           String    @id @default(cuid())
  findingId    String
  userId       String
  feedbackType String    // HELPFUL, FALSE_POSITIVE, MISLEADING, NOT_APPLICABLE
  comment      String?
  createdAt    DateTime  @default(now())

  finding      Finding   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id               String       @id @default(cuid())
  organizationId   String
  periodYear       Int
  periodMonth      Int
  reviewCount      Int          @default(0)
  tokenCount       Int          @default(0)
  estimatedCostUsd Float        @default(0.0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodYear, periodMonth])
}

model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String
  stripeSubscriptionId String?      @unique
  plan                 String       @default("FREE")
  status               String       @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED, INCOMPLETE
  currentPeriodStart   DateTime     @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id                 String    @id @default(cuid())
  deliveryId         String    @unique
  eventType          String
  repositoryFullName String?
  status             String    @default("PENDING") // PENDING, PROCESSED, IGNORED, FAILED
  payloadJson        String
  errorMessage       String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  detailsJson    String        @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String       @unique
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model InstallationState {
  id             String    @id @default(cuid())
  state          String    @unique
  organizationId String
  userId         String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([state])
  @@index([organizationId])
}

model RepositoryIndexJob {
  id              String      @id @default(cuid())
  repositoryId    String
  commitSha       String
  branch          String      @default("main")
  status          String      @default("QUEUED") // QUEUED, CLONING, CHUNKING, EMBEDDING, COMPLETED, FAILED, SUPERSEDED
  progressPercent Int         @default(0)
  totalFiles      Int         @default(0)
  indexedFiles    Int         @default(0)
  totalChunks     Int         @default(0)
  statusMessage   String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  durationSeconds Float?
  tokensUsed      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  repository      Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, commitSha])
  @@index([status])
}

model IndexedFile {
  id            String      @id @default(cuid())
  repositoryId  String
  filePath      String
  commitSha     String
  language      String
  sizeBytes     Int
  lineCount     Int
  contentHash   String
  lastIndexedAt DateTime    @default(now())

  repository    Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  chunks        CodeChunk[]

  @@unique([repositoryId, filePath])
  @@index([repositoryId, commitSha])
}

model CodeChunk {
  id            String      @id @default(cuid())
  fileId        String
  repositoryId  String
  filePath      String
  startLine     Int
  endLine       Int
  content       String
  tokenCount    Int
  embeddingJson String?     // Float array stored as JSON for portable high-dimensional vector search
  symbolContext String?     // Top-level function, class, or symbol scope
  commitSha     String
  createdAt     DateTime    @default(now())

  file          IndexedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  repository    Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, filePath])
  @@index([commitSha])
}

model CodebaseConversation {
  id           String            @id @default(cuid())
  repositoryId String
  userId       String
  title        String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     CodebaseMessage[]

  @@index([repositoryId, userId])
}

model CodebaseMessage {
  id             String               @id @default(cuid())
  conversationId String
  role           String               // USER, ASSISTANT
  content        String
  citationsJson  String               @default("[]") // JSON array of citations { filePath, startLine, endLine, commitSha, snippet }
  tokensUsed     Int                  @default(0)
  createdAt      DateTime             @default(now())

  conversation   CodebaseConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model TestSuggestion {
  id                   String       @id @default(cuid())
  pullRequestId        String?
  repositoryId         String
  behaviorTested       String
  rationale            String
  targetFile           String
  testFramework        String       // jest, vitest, mocha, node:test, pytest
  proposedCode         String
  edgeCases            String       @default("[]") // JSON array of edge cases
  existingCoverageNotes String?
  status               String       @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, APPLIED
  createdAt            DateTime     @default(now())

  pullRequest          PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  repository           Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([pullRequestId])
}

model ApprovalRequest {
  id                String       @id @default(cuid())
  organizationId    String
  repositoryId      String
  userId            String       // Requester
  approvedByUserId  String?      // Approver
  actionType        String       // CREATE_BRANCH, CREATE_PR, APPLY_PATCH, COMMIT_FILE
  targetBranch      String
  targetCommitSha   String
  title             String
  description       String
  payloadJson       String       // Exact patch or content to apply
  nonce             String       @unique // Cryptographic one-time token preventing replays
  status            String       @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED, EXPIRED
  rejectionReason   String?
  executionResult   String?
  expiresAt         DateTime
  executedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository        Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, repositoryId])
  @@index([nonce])
}

model EvaluationBenchmarkRun {
  id                       String   @id @default(cuid())
  datasetVersion           String
  provider                 String
  model                    String
  totalCases               Int
  precision                Float
  recall                   Float
  falsePositiveRate        Float
  severityAccuracy         Float
  evidenceLocationAccuracy Float
  unsupportedClaimRate     Float
  avgLatencyMs             Float
  totalTokensUsed          Int
  detailsJson              String   @default("{}")
  createdAt                DateTime @default(now())
}


