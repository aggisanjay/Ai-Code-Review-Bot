# ReviewFlow AI — Environment Configuration Template
# Copy this file to .env for local development

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Next.js Public Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEMO_MODE=true

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reviewflow?schema=public"

# Redis (BullMQ & Cache)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="dev-insecure-secret-change-in-production-min-32-chars-long"
SESSION_SECRET="dev-session-secret-change-in-production-min-32-chars-long"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# GitHub App Integration
# In development, you can use mock adapter mode without GitHub credentials!
GITHUB_APP_ID="123456"
GITHUB_CLIENT_ID="Iv1.mockclientid"
GITHUB_CLIENT_SECRET="mock_github_client_secret"
GITHUB_WEBHOOK_SECRET="development_webhook_secret_key"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAz...MOCK_DEV_KEY...\n-----END RSA PRIVATE KEY-----"
GITHUB_MOCK_MODE=true

# AI Providers Configuration
# ReviewFlow AI supports both Google Gemini and OpenAI with provider fallbacks
AI_PROVIDER="mock" # Options: "mock", "gemini", "openai"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_GEMINI="gemini-1.5-pro-latest"
AI_MODEL_OPENAI="gpt-4o"
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1

# Stripe Subscription & Billing (Test Mode)
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook"
STRIPE_PRICE_ID_PRO="price_mock_pro_monthly"
STRIPE_PRICE_ID_TEAM="price_mock_team_monthly"
BILLING_MOCK_MODE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
