# ReviewFlow AI — Environment Configuration Template
# Copy this file to .env for production or local development

# ------------------------------------------------------------------------------
# Core Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Next.js Public Endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Production: PostgreSQL connection string (Neon or Self-Hosted) with Prisma
# Example Neon: postgresql://neondb_owner:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reviewflow?schema=public"

# Local SQLite fallback (supported for portable development without PostgreSQL)
# DATABASE_URL="file:./packages/database/prisma/dev.db"

# ------------------------------------------------------------------------------
# Redis & BullMQ Job Queue
# ------------------------------------------------------------------------------
# Durable background queue for review jobs
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Security, Sessions & JWT
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-secure-32-char-random-key-in-production"
SESSION_SECRET="replace-with-secure-session-secret-in-production"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# GitHub App Integration
# ------------------------------------------------------------------------------
# Platform-owned single GitHub App:
# - Setup URL: https://<domain>/onboarding
# - Webhook URL: https://<api-domain>/api/v1/webhooks/github
# - Permissions: Pull Requests (Read & Write), Checks (Read & Write), Contents (Read)
# - Events: pull_request, installation, installation_repositories
GITHUB_APP_ID="123456"
GITHUB_APP_SLUG="reviewflow-ai"
GITHUB_CLIENT_ID="Iv1.yourclientid"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_WEBHOOK_SECRET="your_github_signed_webhook_secret_hmac"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_MOCK_MODE=false

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini & OpenAI)
# ------------------------------------------------------------------------------
AI_PROVIDER="gemini" # Options: "gemini", "openai"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_GEMINI="gemini-1.5-pro-latest"
AI_MODEL_OPENAI="gpt-4o"
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# Stripe Billing (Test & Production Mode)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_TEAM="price_..."
BILLING_MOCK_MODE=false

# ------------------------------------------------------------------------------
# Rate Limiting & Protection
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
